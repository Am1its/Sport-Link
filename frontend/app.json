{
  "expo": {
    "name": "SportLink",
    "slug": "sportlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo4.png",
    "scheme": "sportlink",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Logo4.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1C1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.am1its.sportlink",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.393613161940-tlkf5mb8gfi3fp9e93ni7eijn6t18qpd"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/Logo4.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/Logo4.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Logo4.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#1C1C1E",
          "dark": {
            "backgroundColor": "#1C1C1E"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
